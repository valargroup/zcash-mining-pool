[Unit]
Description=Zallet (Zcash Wallet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zec
Group=zec
ExecStartPre=/bin/rm -f /home/zec/.zallet/.lock
ExecStart=/home/zec/zallet/target/release/zallet --datadir /home/zec/.zallet start
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/zec/zallet.log
StandardError=append:/home/zec/zallet.log

# Hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
