[Unit]
Description=Zallet (Zcash Wallet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zebra
Group=zebra
ExecStartPre=/bin/rm -f /home/zebra/.zallet/.lock
ExecStart=/home/zebra/zallet/target/release/zallet --datadir /home/zebra/.zallet start
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/zebra/zallet.log
StandardError=append:/home/zebra/zallet.log

# Hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
