[Unit]
Description=Zcash Mining Pool
After=network-online.target zallet.service
Wants=network-online.target
Requires=zallet.service

[Service]
Type=simple
User=zebra
Group=zebra
WorkingDirectory=/home/zebra/zecminer/pool
ExecStart=/home/zebra/zecminer/pool/target/release/zcash-pool config/pool.toml
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/zebra/zecminer/pool/pool.log
StandardError=append:/home/zebra/zecminer/pool/pool.log

# Hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
