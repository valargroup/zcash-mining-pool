[Unit]
Description=Zcash Pool Dashboard
After=network-online.target
Wants=network-online.target zcash-pool.service

[Service]
Type=simple
User=zebra
Group=zebra
WorkingDirectory=/home/zebra/zecminer/pool
ExecStart=/home/zebra/zecminer/pool/target/release/zcash-dashboard config/pool.toml
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/zebra/zecminer/pool/dashboard.log
StandardError=append:/home/zebra/zecminer/pool/dashboard.log

# Hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
