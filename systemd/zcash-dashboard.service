[Unit]
Description=Zcash Pool Dashboard
After=network-online.target
Wants=network-online.target zcash-pool.service

[Service]
Type=simple
User=zec
Group=zec
WorkingDirectory=/home/zec/zcash-mining-pool
ExecStart=/home/zec/zcash-mining-pool/target/release/zcash-dashboard config/pool.toml
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/zec/zcash-mining-pool/dashboard.log
StandardError=append:/home/zec/zcash-mining-pool/dashboard.log

# Hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
