# Zebra testnet configuration for mining pool integration.
# See: https://zebra.zfnd.org/user/mining-testnet-s-nomp.html

[network]
network = "Testnet"
listen_addr = "0.0.0.0:18233"

[state]
cache_dir = "/path/to/zebrad/state"

[rpc]
# Bind to 127.0.0.1 for local-only access, or 0.0.0.0 if pool runs on a different host
listen_addr = "127.0.0.1:18232"
enable_cookie_auth = false

[mining]
# For payout.coinbase_mode = "transparent", use a transparent address and set
# payout.mining_address to the same value in pool.toml.
#
# For payout.coinbase_mode = "direct_shielded", use an Orchard-only unified
# address from payout.pool_address in pool.toml. Verify the receiver type with
# your Zebra build before switching production mining.
miner_address = "YOUR_TESTNET_ADDRESS_HERE"
# Optional pool tag. Use this instead of pool.coinbase_tag when mining directly
# to a shielded address.
# extra_coinbase_data = "MyPool"

[tracing]
endpoint_addr = "127.0.0.1:3000"
